# Copy to .env and fill in. The server reads this file at startup and caches the
# parsed result, so a change here needs a server restart to take effect.
#
# Only MONGODB_URI and JWT_SECRET are required. Everything else has a working
# local default, so the whole app demos without any third-party accounts.

# --- required ---------------------------------------------------------------

# MongoDB Atlas connection string, including the database name.
# Atlas → Cluster → Connect → Drivers. Remember to allow your IP in Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/medihelp

# Secret used to sign access tokens. Any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- server -----------------------------------------------------------------

PORT=4000
NODE_ENV=development

# Comma-separated origins allowed to call the API in production. Ignored in
# development, where Vite proxies /api and there is no cross-origin request.
CORS_ORIGINS=http://localhost:5173

# --- tokens -----------------------------------------------------------------

# Access token lifetime. Short on purpose: the refresh cookie covers the gap.
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime.
REFRESH_TOKEN_TTL=7d

# --- seed -------------------------------------------------------------------

# The admin account created by `npm run seed`. Admins are never self-registerable.
SEED_ADMIN_EMAIL=admin@medihelp.test
SEED_ADMIN_PASSWORD=

# --- payments ---------------------------------------------------------------

# mock (default) creates a fake order and marks it paid, so checkout works with
# no account. Set to razorpay and fill in the keys to use the real gateway.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- file storage -----------------------------------------------------------

# local (default) writes uploads to server/uploads and serves them from /uploads.
STORAGE_PROVIDER=local

# --- ai triage --------------------------------------------------------------

# Leave the key empty to use the built-in rules engine, which is deterministic,
# offline, and the fallback whenever a model call fails. Set the key to use
# Claude instead.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-sonnet-5
TRIAGE_TIMEOUT_MS=8000
